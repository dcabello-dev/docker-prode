# Copiá este archivo a .env y completá los valores reales en el servidor.
#   cp .env.example .env
# El archivo .env NO se sube al repo (está en .gitignore).

# Clave secreta de Django. Generá una nueva y larga, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-secreta

# Dominios/IPs permitidos, separados por coma (sin https://)
DJANGO_ALLOWED_HOSTS=prode.ies9018malargue.edu.ar,localhost,127.0.0.1

# Orígenes confiables para CSRF, separados por coma (CON https://)
DJANGO_CSRF_TRUSTED_ORIGINS=https://prode.ies9018malargue.edu.ar
