# Copiá este archivo a .env y completá los valores reales en el servidor.
#   cp .env.example .env
# El archivo .env NO se sube al repo (está en .gitignore).

# Clave secreta de Django. Generá una nueva y larga, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-secreta

# Dominios/IPs permitidos, separados por coma (sin https://)
DJANGO_ALLOWED_HOSTS=prode.ies9018malargue.edu.ar,localhost,127.0.0.1

# Orígenes confiables para CSRF, separados por coma (CON https://)
DJANGO_CSRF_TRUSTED_ORIGINS=https://prode.ies9018malargue.edu.ar

# --- PostgreSQL ---
# El contenedor "db" (prode-postgres) usa estas variables para inicializarse y
# docker-compose arma con ellas el DATABASE_URL que consume el contenedor "web".
# Vive en la red interna privada del stack. La contraseña es obligatoria.
POSTGRES_DB=prode
POSTGRES_USER=prode
POSTGRES_PASSWORD=cambiame-por-una-password-de-db-segura

# Para desarrollo local SIN Docker podés setear DATABASE_URL a mano; si no se
# define, Django cae a SQLite. En Docker lo arma docker-compose automáticamente.
# DATABASE_URL=postgres://prode:password@localhost:5432/prode

# --- SofaScore ---
# auto = RapidAPI si hay key, con fallback a API directa ante 403
# rapidapi = solo RapidAPI | direct = solo API directa (curl_cffi)
SOFASCORE_BACKEND=auto
# Clave de https://rapidapi.com/apidojo/api/sofascore (suscribite al plan Basic)
RAPIDAPI_KEY=tu-api-key-de-rapidapi
RAPIDAPI_HOST=sofascore.p.rapidapi.com
SOFASCORE_SPORT=football
# uniqueTournament.id de SofaScore (NO es tournament.id de la fase).
# Mundial FIFA suele ser 16. Descubrilo con: python manage.py listar_torneos
SOFASCORE_TOURNAMENT_ID=16

# Usuario administrador del Prode (lo usa ./crear-admin.sh y el comando
# "python manage.py crear_admin"). La contraseña es obligatoria.
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_PASSWORD=cambiame-por-una-password-segura
DJANGO_ADMIN_EMAIL=admin@ies9018malargue.edu.ar
